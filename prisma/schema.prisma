generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum Childrentatus {
  NORMAL
  LOWRISK
  HIGHRISK
}

model Admin {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admins")
}

model Parents {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  address      String
  clinic_id    String
  phone_number String   @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  clinic   Clinic      @relation(fields: [clinic_id], references: [id])
  children Childrens[]

  @@map("parents")
}

model Childrens {
  id         String         @id @default(uuid())
  name       String
  birth_date DateTime
  parent_id  String
  gender     Gender
  address    String
  status     Childrentatus?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent       Parents        @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  measurements Measurements[]

  @@map("childrens")
}

model Measurements {
  id String @id @default(uuid())

  children_id      String
  measurement_date DateTime

  age_month Int

  body_weight        Float
  body_height        Float
  head_circumference Float?

  zscore_bb   Float?
  zscore_tb   Float?
  zscore_lk   Float?
  zscore_gizi Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  children Childrens @relation(fields: [children_id], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model Cadre {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("cadres")
}

model Province {
  id   String @id
  name String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  regencies  Regency[]

  @@map("provinces")
}

model Regency {
  id          String @id
  province_id String
  name        String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  province  Province   @relation(fields: [province_id], references: [id], onDelete: Cascade)
  districts District[]

  @@map("regencies")
}

model District {
  id         String @id
  regency_id String
  name       String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  regency  Regency   @relation(fields: [regency_id], references: [id], onDelete: Cascade)
  villages Village[]

  @@map("districts")
}

model Village {
  id          String @id
  district_id String
  name        String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  district District @relation(fields: [district_id], references: [id], onDelete: Cascade)
  clinics  Clinic[]

  @@map("villages")
}

model Clinic {
  id         String   @id @default(uuid())
  name       String
  address    String
  village_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  village Village   @relation(fields: [village_id], references: [id], onDelete: Cascade)
  parents Parents[]

  @@map("clinics")
}
