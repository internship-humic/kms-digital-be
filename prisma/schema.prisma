generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum Childrentatus {
  NORMAL
  LOWRISK
  HIGHRISK
}

enum ArticleType {
  ACTIVITY
  NUTRITION
  HEALTH
}

enum UserRole {
  ADMIN
  CADRE
  PARENTS
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationCategory {
  ARTICLE
  MEASUREMENT
  SCHEDULE
  ANNOUNCEMENT
  ACCOUNT
}

model Admin {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admins")
}

model Parents {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  address      String
  clinic_id    String
  phone_number String   @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  clinic   Clinic      @relation(fields: [clinic_id], references: [id])
  children Childrens[]

  @@map("parents")
}

model Childrens {
  id             String         @id @default(uuid())
  name           String
  birth_date     DateTime
  parent_id      String
  gender         Gender
  address        String
  status         Childrentatus?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent       Parents        @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  measurements Measurements[]
  intervention Interventions?

  @@map("childrens")
}

model Measurements {
  id String @id @default(uuid())

  children_id      String
  clinic_id        String
  measurement_date DateTime

  age_month   Int
  description String?

  body_weight        Float
  body_height        Float
  head_circumference Float?

  zscore_bb   Float?
  zscore_tb   Float?
  zscore_lk   Float?
  zscore_gizi Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  clinic   Clinic    @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  children Childrens @relation(fields: [children_id], references: [id], onDelete: Cascade)

  @@map("measurements")
}

model Cadre {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  password      String
  clinic_id     String
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  clinic        Clinic          @relation(fields: [clinic_id], references: [id], onDelete: Cascade)
  interventions Interventions[]

  @@map("cadres")
}

model Interventions {
  id             String   @id @default(uuid())
  children_id    String   @unique
  cadre_id       String?
  is_intervented Boolean  @default(false)
  referral       Boolean  @default(false)
  supplement     Boolean  @default(false)
  education      Boolean  @default(false)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  children       Childrens @relation(fields: [children_id], references: [id], onDelete: Cascade)
  cadre          Cadre?    @relation(fields: [cadre_id], references: [id], onDelete: SetNull)

  @@map("interventions")
}

model Province {
  id   String @id
  name String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  regencies  Regency[]

  @@map("provinces")
}

model Regency {
  id          String @id
  province_id String
  name        String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  province  Province   @relation(fields: [province_id], references: [id], onDelete: Cascade)
  districts District[]

  @@map("regencies")
}

model District {
  id         String @id
  regency_id String
  name       String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  regency  Regency   @relation(fields: [regency_id], references: [id], onDelete: Cascade)
  villages Village[]

  @@map("districts")
}

model Village {
  id          String @id
  district_id String
  name        String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  district District @relation(fields: [district_id], references: [id], onDelete: Cascade)
  clinics  Clinic[]

  @@map("villages")
}

model Clinic {
  id         String   @id @default(uuid())
  name       String
  address    String
  village_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  village      Village        @relation(fields: [village_id], references: [id], onDelete: Cascade)
  parents      Parents[]
  measurements Measurements[]
  Cadre        Cadre[]

  @@map("clinics")
}

model Article {
  id              String      @id @default(uuid())
  title           String
  description     String
  content         Json
  cover_image     String?
  writer_name     String
  writer_identity String
  type            ArticleType

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("articles")
}

model Notification {
  id String @id @default(uuid())

  recipient_id   String
  recipient_role UserRole

  title   String
  message String

  category NotificationCategory

  is_read Boolean @default(false)

  reference_id   String?
  reference_type String?

  created_at DateTime @default(now())

  @@map("notifications")
}
